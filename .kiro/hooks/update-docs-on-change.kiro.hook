{
  "enabled": true,
  "name": "Update Docs on Source Change",
  "description": "When Python source files, config files, or other relevant project files are edited, asks the agent to update the README or .theory_files documentation to reflect the changes.",
  "version": "1",
  "when": {
    "type": "fileEdited",
    "patterns": [
      "*.py",
      "*.yaml",
      "*.yml",
      "*.html",
      "*.js",
      "*.css",
      "requirements.txt"
    ]
  },
  "then": {
    "type": "askAgent",
    "prompt": "A source file was just edited. Review the change and determine if any documentation needs updating. If the change affects public APIs, configuration options, project structure, commands, or features documented in the README.md or .theory_files/ folder, update the relevant documentation to stay in sync. Only make documentation changes if the code change is meaningful (not just formatting or minor refactors)."
  }
}